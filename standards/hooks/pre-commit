#!/bin/bash
# AppSec Pre-Commit Hook — Advisory Only
# Scans staged files and reports findings as warnings.
# Does NOT block commits — enforcement happens in the CI/CD pipeline.

STATE_DIR=".appsec-state"
DISMISSED_FILE="$STATE_DIR/dismissed.json"
RULES_FILE="rules/security.yml"

mkdir -p "$STATE_DIR"

# Get staged code files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -iE '\.(ts|tsx|js|jsx|java|py|go|rb|php|c|cpp|cs|swift|kt|rs|scala)$')
[ -z "$STAGED_FILES" ] && exit 0

# Find rules
if [ ! -f "$RULES_FILE" ]; then
  GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
  [ -f "$GIT_ROOT/rules/security.yml" ] && RULES_FILE="$GIT_ROOT/rules/security.yml" || exit 0
fi

command -v opengrep &>/dev/null || exit 0

# Run scan
TMPFILE=$(mktemp)
opengrep scan --json --quiet --config="$RULES_FILE" $STAGED_FILES > "$TMPFILE" 2>/dev/null || true

# Display advisory report (dismissed findings are filtered out — already reviewed)
python3 - "$TMPFILE" "$DISMISSED_FILE" << 'EOF'
import sys, json, os

tmpfile = sys.argv[1]
dismissed_file = sys.argv[2] if len(sys.argv) > 2 else None

try:
    with open(tmpfile) as f:
        d = json.load(f)
    results = d.get('results', [])
except:
    sys.exit(0)
finally:
    if os.path.exists(tmpfile):
        os.unlink(tmpfile)

if not results:
    sys.exit(0)

# Filter out dismissed findings so they don't clutter the output
dismissed_keys = set()
if dismissed_file and os.path.exists(dismissed_file):
    try:
        with open(dismissed_file) as f:
            dismissed = json.load(f)
        for d_item in dismissed:
            raw_id = d_item.get('id', '')
            rule_name = raw_id.split('.rules.')[-1] if '.rules.' in raw_id else raw_id.split('.')[-1]
            dismissed_keys.add((rule_name, d_item.get('file', ''), d_item.get('line', 0)))
            dismissed_keys.add((rule_name, d_item.get('file', ''), 0))
    except:
        pass

if dismissed_keys:
    filtered = []
    for r in results:
        cid = r.get('check_id', '')
        rule_name = cid.split('.rules.')[-1] if '.rules.' in cid else cid.split('.')[-1]
        fp = r.get('path', '')
        ln = r.get('start', {}).get('line', 0)
        if (rule_name, fp, ln) not in dismissed_keys and (rule_name, fp, 0) not in dismissed_keys:
            filtered.append(r)
    results = filtered

if not results:
    sys.exit(0)

groups = {}
for r in results:
    rule = r.get('check_id', '?').split('.')[-1].replace('-', ' ').title()
    sev = r.get('extra', {}).get('severity', 'INFO').upper()
    f = r.get('path', '?')
    key = (sev, rule)
    if key not in groups:
        groups[key] = {'count': 0, 'files': set()}
    groups[key]['count'] += 1
    groups[key]['files'].add(f)

total = len(results)
error_c = sum(1 for r in results if r.get('extra',{}).get('severity','').upper() == 'ERROR')
warn_c  = sum(1 for r in results if r.get('extra',{}).get('severity','').upper() == 'WARNING')
info_c  = total - error_c - warn_c

Y = '\033[33m'; C = '\033[36m'; B = '\033[1m'; N = '\033[0m'; D = '\033[2m'; R = '\033[31m'

print()
print(f'  {B}{Y}┌──────────────────────────────────────────────────────────────────┐{N}')
print(f'  {B}{Y}│  ⚠️  AppSec — {total} vulnerabilidade(s) detectada(s) no commit      │{N}')
print(f'  {B}{Y}└──────────────────────────────────────────────────────────────────┘{N}')
print()

parts = []
if error_c: parts.append(f'{R}{B}{error_c} critical/high{N}')
if warn_c:  parts.append(f'{Y}{warn_c} medium{N}')
if info_c:  parts.append(f'{C}{info_c} low/info{N}')
print(f'  {" · ".join(parts)}')
print()

print(f'  {D}{"─"*66}{N}')
print(f'  {B} {"Sev":<9} {"Qtd":<5} {"Vulnerabilidade":<26} {"Arquivos"}{N}')
print(f'  {D}{"─"*66}{N}')

sev_order = {'ERROR': 0, 'WARNING': 1, 'INFO': 2}
sev_icon  = {'ERROR': f'{R}●{N}', 'WARNING': f'{Y}●{N}', 'INFO': f'{C}●{N}'}

for (sev, rule), data in sorted(groups.items(), key=lambda x: sev_order.get(x[0][0], 3)):
    icon = sev_icon.get(sev, '○')
    files_str = ', '.join(sorted(data['files']))
    if len(files_str) > 20:
        files_str = files_str[:17] + '...'
    if len(rule) > 24:
        rule = rule[:21] + '...'
    print(f'  {icon} {sev:<8} {data["count"]:<5} {rule:<26} {D}{files_str}{N}')

print(f'  {D}{"─"*66}{N}')
print()
print(f'  {D}O commit será aceito. O SAST da pipeline irá validar e bloquear se necessário.{N}')
print()

# Always exit 0 — never block locally
sys.exit(0)
EOF

exit 0
