# Source code (not needed — compiled output is in out/)
src/**
tsconfig.json
eslint.config.mjs

# Development tools
node_modules/**
.vscode/**
.vscode-test/**

# MDM deploy scripts (not part of the extension)
deploy/**
dist/**
scripts/**

