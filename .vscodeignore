.claude/**
.cursor/**

# Test files (not needed in production)
Teste*.js
test-*
.appsec/**

# Git and CI
.git/**
.github/**
.gitignore

# Source maps (not needed in production)
out/**/*.map

# Build artifacts
*.vsix

# OS files
.DS_Store
Thumbs.db
