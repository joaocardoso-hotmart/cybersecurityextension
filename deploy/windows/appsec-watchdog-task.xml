<?xml version="1.0" encoding="UTF-16"?>
<!--
  AppSec Watchdog — Windows Task Scheduler Definition

  Deploy via MDM:
    1. Copy mdm-watchdog.ps1 to C:\ProgramData\Hotmart\appsec\
    2. Copy this file to C:\ProgramData\Hotmart\appsec\
    3. MDM runs:
         schtasks /Create /XML "C:\ProgramData\Hotmart\appsec\appsec-watchdog-task.xml" /TN "Hotmart\AppSecWatchdog" /F

  Runs every 30 minutes as SYSTEM, starting at logon.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Hotmart AppSec Watchdog — verifies and restores security extension and standards</Description>
    <Author>Hotmart IT Security</Author>
    <URI>\Hotmart\AppSecWatchdog</URI>
  </RegistrationInfo>

  <Triggers>
    <!-- Run at system startup -->
    <BootTrigger>
      <Enabled>true</Enabled>
      <Delay>PT2M</Delay>
    </BootTrigger>
    <!-- Run every 30 minutes indefinitely -->
    <TimeTrigger>
      <Repetition>
        <Interval>PT30M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2024-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- Runs as SYSTEM — can manage all user files -->
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- Kill after 5 minutes if still running -->
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <!-- Below Normal priority — won't compete with the dev's IDE or builds -->
    <Priority>7</Priority>
  </Settings>

  <Actions>
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NonInteractive -NoProfile -ExecutionPolicy Bypass -File "C:\ProgramData\Hotmart\appsec\mdm-watchdog.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
